/* Prefab Brush inspector. Colours follow WorldBuilderWindow.uss (VS Code dark + #007ACC). */

.pb-root .unity-base-field {
    margin-left: 0;
    margin-right: 0;
}

.pb-root .unity-base-field__label {
    min-width: 128px;
    color: #BBBBBB;
}

/* ------------------------------------------------------------------ mode switch */

.pb-mode {
    flex-direction: row;
    padding: 2px;
    margin-bottom: 4px;
    background-color: #252526;
    border-width: 1px;
    border-color: #3E3E42;
    border-radius: 4px;
}

.pb-mode__button {
    flex-grow: 1;
    height: 26px;
    margin: 0;
    background-color: transparent;
    border-width: 0;
    border-radius: 3px;
    color: #9D9D9D;
    -unity-font-style: bold;
}

.pb-mode__button:hover {
    color: #D4D4D4;
    background-color: #2D2D30;
}

.pb-mode__button--active,
.pb-mode__button--active:hover {
    background-color: #007ACC;
    color: #FFFFFF;
}

.pb-mode__button--erase.pb-mode__button--active,
.pb-mode__button--erase.pb-mode__button--active:hover {
    background-color: #A1260D;
}

/* ------------------------------------------------------------------ cards */

.pb-card {
    padding: 8px 10px 10px 10px;
    margin-bottom: 8px;
    background-color: #252526;
    border-width: 1px;
    border-color: #3E3E42;
    border-radius: 4px;
}

.pb-card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 5px;
    margin-bottom: 6px;
    border-bottom-width: 1px;
    border-bottom-color: #333337;
}

.pb-card__title {
    color: #D4D4D4;
    font-size: 12px;
    -unity-font-style: bold;
}

.pb-card__meta {
    color: #8B8B8B;
    font-size: 11px;
}

.pb-foldout {
    margin-bottom: 8px;
    background-color: #252526;
    border-width: 1px;
    border-color: #3E3E42;
    border-radius: 4px;
}

.pb-foldout > .unity-foldout__toggle {
    margin: 0;
    padding: 5px 6px;
    background-color: #2D2D30;
    border-radius: 3px;
}

.pb-foldout > .unity-foldout__toggle:hover {
    background-color: #37373D;
}

.pb-foldout > .unity-foldout__toggle .unity-foldout__text {
    color: #D4D4D4;
    -unity-font-style: bold;
}

.pb-foldout > .unity-foldout__content {
    margin-left: 0;
    padding: 6px 10px 8px 10px;
}

/* ------------------------------------------------------------------ small parts */

.pb-hint {
    color: #8B8B8B;
    font-size: 11px;
    white-space: normal;
    margin-top: 2px;
    margin-bottom: 6px;
}

.pb-row {
    flex-direction: row;
    align-items: center;
}

.pb-row--end {
    justify-content: flex-end;
}

.pb-button {
    height: 22px;
    margin: 0 4px 0 0;
    padding: 0 10px;
    background-color: #3A3D41;
    border-width: 0;
    border-radius: 3px;
    color: #D4D4D4;
}

.pb-button:hover {
    background-color: #45494E;
}

.pb-button--primary {
    background-color: #0E639C;
    color: #FFFFFF;
}

.pb-button--primary:hover {
    background-color: #1177BB;
}

.pb-button--danger:hover {
    background-color: #5A1D1D;
    color: #F48771;
}

.pb-button--grow {
    flex-grow: 1;
}

/* ------------------------------------------------------------------ tiles */

.pb-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.pb-tile {
    padding: 4px;
    margin: 0 6px 6px 0;
    background-color: #2D2D30;
    border-width: 1px;
    border-color: #3E3E42;
    border-radius: 4px;
}

.pb-tile:hover {
    background-color: #37373D;
    border-color: #505055;
}

.pb-tile--in-palette {
    border-color: #1B5E8C;
}

.pb-tile--selected,
.pb-tile--selected:hover {
    background-color: #04395E;
    border-color: #007ACC;
}

.pb-tile--off {
    opacity: 0.45;
}

.pb-tile__image {
    background-color: #1E1E1E;
    border-radius: 3px;
}

.pb-tile__label {
    margin-top: 3px;
    font-size: 10px;
    color: #CCCCCC;
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.pb-tile__badge {
    position: absolute;
    top: 6px;
    right: 6px;
    padding: 0 4px;
    font-size: 9px;
    color: #FFFFFF;
    background-color: #007ACC;
    border-radius: 3px;
    -unity-font-style: bold;
}

.pb-tile__badge--muted {
    color: #9D9D9D;
    background-color: #3A3D41;
}

.pb-tile__tag {
    position: absolute;
    top: 6px;
    left: 6px;
    padding: 0 4px;
    font-size: 9px;
    color: #1E1E1E;
    background-color: #4EC9B0;
    border-radius: 3px;
    -unity-font-style: bold;
}

.pb-empty {
    padding: 16px 10px;
    margin-bottom: 6px;
    color: #8B8B8B;
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: #1E1E1E;
    border-width: 1px;
    border-color: #3E3E42;
    border-radius: 4px;
}

.pb-drop-target {
    background-color: #0F2A3F;
    border-color: #007ACC;
}

/* ------------------------------------------------------------------ selected model */

.pb-detail {
    padding: 8px;
    margin-top: 2px;
    background-color: #1E1E1E;
    border-width: 1px;
    border-color: #007ACC;
    border-radius: 4px;
}

.pb-detail__header {
    flex-direction: row;
    margin-bottom: 8px;
}

.pb-detail__preview {
    width: 80px;
    height: 80px;
    flex-shrink: 0;
    background-color: #252526;
    border-radius: 3px;
}

.pb-detail__info {
    flex-grow: 1;
    margin-left: 10px;
    justify-content: space-between;
}

.pb-detail__name {
    color: #D4D4D4;
    font-size: 13px;
    -unity-font-style: bold;
}

.pb-detail__path {
    color: #8B8B8B;
    font-size: 10px;
    white-space: normal;
}

.pb-share {
    margin: 2px 0 8px 0;
}

.pb-share__track {
    height: 4px;
    margin-bottom: 3px;
    background-color: #3E3E42;
    border-radius: 2px;
}

.pb-share__fill {
    height: 4px;
    background-color: #007ACC;
    border-radius: 2px;
}

.pb-share__label {
    color: #8B8B8B;
    font-size: 11px;
}

.pb-subsection {
    margin-top: 6px;
    padding-top: 6px;
    border-top-width: 1px;
    border-top-color: #333337;
}

/* ------------------------------------------------------------------ library */

.pb-library-scroll {
    max-height: 380px;
    margin-top: 6px;
}

.pb-library-toolbar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
}

.pb-library-toolbar .unity-toolbar-search-field {
    flex-grow: 1;
    width: auto;
    margin-left: 0;
}

.pb-size-slider {
    width: 90px;
    margin-left: 6px;
}
